# Node / Capacitor
node_modules/
npm-debug.log*

# Capacitor / Android build outputs
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/app/release/
android/app/debug/
android/captures/
android/.idea/
android/*.iml
android/app/*.iml
# Gradle wrapper zip — downloaded automatically by gradlew on first run.
# Never commit this; it's 200+ MB and exceeds GitHub's 100 MB file limit.
android/gradle/wrapper/gradle-*-all.zip
android/gradle/wrapper/gradle-*.zip
# Gradle wrapper jar — keep gradle-wrapper.jar (small, ~60KB); the -all.zip
# is the distribution that gradlew downloads. The jar is the launcher.

# Web build outputs
www/engine/build/

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Generated by version:increment — keep package.json / android/app/build.gradle in version control
# but don't track build artifacts.
